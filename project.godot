; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Turno Nocturno"
config/description="Survival horror en 2D: un velador busca a su compañero en un campus universitario vacío."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
Dialogos="*res://scripts/autoload/dialogos.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[input]

mover_arriba={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
mover_abajo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
mover_izquierda={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
mover_derecha={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
correr={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"button_index":9)]
}
interactuar={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":0)]
}
linterna={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70), Object(InputEventJoypadButton,"button_index":10)]
}
recargar={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":2)]
}
lanzar={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":71), Object(InputEventJoypadButton,"button_index":1)]
}
radio={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventJoypadButton,"button_index":11)]
}
inventario={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194306), Object(InputEventJoypadButton,"button_index":3)]
}
mapa={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
pausa={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}
mirar_izquierda={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}
mirar_derecha={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}
mirar_arriba={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}
mirar_abajo={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}
apuntar={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
disparar={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}

[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jugador"
2d_physics/layer_3="enemigos"
2d_physics/layer_4="proyectiles"
2d_physics/layer_5="interactuables"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
